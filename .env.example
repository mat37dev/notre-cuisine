# Pour le site en ligne : variables à saisir dans Vercel.
# Pour la commande « npm run invite » : les mettre dans .env.production.local (jamais dans .env.local,
# que « npm run dev » lirait : le site local utiliserait alors la vraie base).
# Adresse du projet Supabase (https://xxxx.supabase.co)
SUPABASE_URL=
# Clé "service role" de Supabase : secrète, jamais dans le navigateur
SUPABASE_SERVICE_ROLE_KEY=
# Secret aléatoire que Vercel envoie à la tâche planifiée
CRON_SECRET=
# Adresse publique du site (https://notre-cuisine.vercel.app)
SITE_URL=
# Texte aléatoire pour hacher les adresses IP des envois
IP_HASH_SALT=
